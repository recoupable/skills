# Resolver-eval fixtures — middle-tier (domain-grouped skills).
# One JSON object per line: {"intent": <user phrasing>, "expected": <skill that owns it>, "not": [<must-not-fire>]}
# Run: python3 scripts/run_resolver_eval.py
# Goal: prove each skill fires for a real phrasing, and the cross-skill forks route correctly.

# --- platform ---
{"intent": "set me up, verify my email and give me an api key", "expected": "recoup-platform-connect-account"}
{"intent": "how far am I in setting up recoup, what should I do next", "expected": "recoup-platform-track-onboarding", "not": ["recoup-platform-connect-account"]}
{"intent": "did I finish onboarding my account, show my activation checklist", "expected": "recoup-platform-track-onboarding"}
{"intent": "scaffold my workspace folders and mirror my roster into artists/", "expected": "recoup-platform-build-os"}
{"intent": "turn this repo into our label's self-managing music-company OS", "expected": "recoup-platform-build-os"}
{"intent": "call the recoup api to fetch this artist's socials", "expected": "recoup-platform-api-access"}
{"intent": "edit this google doc and sync it to a sandbox file", "expected": "recoup-platform-api-access"}
{"intent": "email me this weekly report as an html email", "expected": "recoup-platform-email-helper", "not": ["recoup-platform-api-access"]}
{"intent": "send the daily trends summary to the artist's manager", "expected": "recoup-platform-email-helper"}
{"intent": "that worked, remember this so we don't redo it next time", "expected": "recoup-platform-capture-lesson"}

